          }
        }
      }
    },
    "SafeBeauty's uid bridge (syncUidMap) failed, so its security rules can't see this admin: %@": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "پل شناسهٔ SafeBeauty (syncUidMap) ناکام شد، پس قواعد امنیتی آن این مدیر را نمی‌بینند: %@"
          }
        }
      }
    },
    "SafeBeauty: %ld identity checks waiting for review": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "SafeBeauty: %ld بررسی هویت در انتظار"
          }
