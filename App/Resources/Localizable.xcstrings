    "Authentication, roles, audit logging and server-side secret management arrive with the backend phase. See docs/security.md.": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "احراز هویت، نقش‌ها، سابقهٔ حسابرسی و مدیریت رمزها در سرور با مرحلهٔ سرور اضافه می‌شوند. docs/security.md را ببینید."
          }
