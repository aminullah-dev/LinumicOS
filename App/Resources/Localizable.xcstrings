{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ %@": {
      "comment": "A label that shows the first 7 characters of a GitHub commit SHA, the date the commit was made, and a tooltip with the full commit message.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ (%@) is blocked.": {
      "extractionState": "stale",
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ (%3$@) مسدود است."
          }
        }
      }
    },
    "%@ %@ (%@, %@) is a release candidate.": {
      "extractionState": "stale",
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ (%3$@، %4$@) نامزد انتشار است."
          }
        }
      }
    },
    "%@ %@ has been submitted and is pending in App Store Connect.": {
      "extractionState": "stale",
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ ارسال شده و در App Store Connect در انتظار است."
          }
        }
      }
    },
    "%@ %@ is now live on %@.": {
      "extractionState": "stale",
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ نسخهٔ %2$@ حالا در %3$@ فعال است."
          }
        }
      }
    },
    "%@ %@ is pending in App Store Connect. That's awaiting Apple, not recorded as blocked.": {
      "extractionState": "stale",
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ در App Store Connect در انتظار است. این منتظر اپل است و مسدود ثبت نشده است."
          }
        }
      }
    },
    "%@ %@ is waiting on %@.": {
      "extractionState": "stale",
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ نسخهٔ %2$@ در %3$@ منتظر است."
          }
        }
      }
    },
    "%@ %@ — %@": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ — %3$@"
          }
        }
      }
    },
    "%@ (%@) answers again.": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) دوباره پاسخ می‌دهد."
          }
        }
      }
    },
    "%@ (%@) failed two checks in a row.": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) در دو بررسی پشت سر هم پاسخ نداد."
          }
        }
      }
    },
    "%@ / %@": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ and its saved password are removed from this device's Keychain. This can't be undone, and it doesn't change the account itself.": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ و رمز ذخیره‌شده‌اش از Keychain همین دستگاه پاک می‌شوند. این کار برگشت ندارد و خود حساب را تغییر نمی‌دهد."
          }
        }
      }
    },
    "%@ copied. The clipboard clears in 30 seconds.": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ کپی شد. کلیپ‌بورد پس از ۳۰ ثانیه پاک می‌شود."
          }
        }
      }
    },
    "%@ is back up": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ دوباره برقرار است"
          }
        }
      }
    },
    "%@ is down": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ قطع است"
          }
        }
      }
    },
    "%@ is required.": {
      "extractionState": "stale",
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لازم است."
          }
        }
      }
    },
    "%@ licence %@ for %@ ends in %lld days (last valid day %@).": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "لایسنس %1$@ با شمارهٔ %2$@ برای %3$@ تا %4$lld روز دیگر ختم می‌شود (آخرین روز معتبر: %5$@)."
          }
        }
      }
    },
    "%@ needs at least one source. Add one, or record your own confirmation.": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» دست‌کم به یک منبع نیاز دارد. یک منبع اضافه کنید یا تأیید خود را ثبت کنید."
          }
        }
      }
    },
    "%@ on %@: %@ → %@": {
      "extractionState": "stale",
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ در %2$@: %3$@ ← %4$@"
          }
        }
      }
    },
    "%@ refused access (403). The account lacks read permission for this app, or a permission granted in the last day hasn't taken effect yet.": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ دسترسی نداد (403). حساب اجازهٔ خواندن این برنامه را ندارد، یا اجازه‌ای که در ۲۴ ساعت گذشته داده شده هنوز فعال نشده است."
          }
        }
      }
    },
    "%@ rejected the credentials (401). Check them in Settings → Integrations.": {
      "extractionState": "stale",
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ اطلاعات ورود را رد کرد (401). آن را در تنظیمات ← اتصال‌ها بررسی کنید."
          }
        }
      }
    },
    "%@ returned HTTP %d.": {
      "extractionState": "stale",
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ خطای HTTP %d برگرداند."
          }
        }
      }
    },
    "%@ will be marked superseded. Its key keeps working in the customer's app until it expires.": {
      "localizations": {
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ «جایگزین‌شده» علامت می‌خورد. کلید آن در برنامهٔ مشتری تا ختم اعتبارش کار می‌کند."
          }
        }
      }
    },
